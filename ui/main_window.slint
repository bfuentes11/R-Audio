import { ScrollView, VerticalBox } from "std-widgets.slint";
import { TextManip } from "globals.slint";
import { ProviderCard } from "components/provider_card.slint";
import {
    SpotifySearch,
    UITrack,
} from "components/spotify/spotify_search.slint";
import { SpotifyDashboard } from "components/spotify/spotify_dashboard.slint";
import { SpotifyAlbum } from "components/spotify/spotify_album.slint";
import { SpotifyArtist } from "components/spotify/spotify_artist.slint";
import { PlayerBar } from "components/player_bar.slint";
import { SpotifyPairing } from "components/spotify/spotify_pairing.slint";
import {
    SpotifyAccounts,
    UIAccount,
} from "components/spotify/spotify_accounts.slint";
import { FullPlayer } from "components/full_player.slint";
import { SetupWindow } from "setup_window.slint";
import { WifiSetup } from "components/wifi/wifi_setup.slint";
import { OobeWelcome } from "components/oobe/oobe_welcome.slint";
import {
    Settings,
    UIWifiNetwork,
    UIBluetoothDevice,
} from "components/settings.slint";
import { BootSplash } from "components/boot_splash.slint";

export { UITrack, UIAccount, SetupWindow, UIWifiNetwork, UIBluetoothDevice, TextManip }

export component MainWindow inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 400px;
    min-height: 300px;

    background: @linear-gradient(180deg, #4E1010 0%, #360D68 100%);

    in-out property <string> active-view: "home";
    in-out property <bool> player-expanded: false;

    // ── Status pill auto-hide ─────────────────────────────────────────────
    // The Wi-Fi/battery pill shows for 5 s on startup or whenever the user
    // taps/drags down from the top edge of the screen, then quietly fades
    // out. Keeps the brand surface (R·Audio title on home, album art on
    // playback views) uncluttered without removing access to status info.
    property <bool> pill-visible: true;
    property <float> pill-alpha: root.pill-visible ? 1.0 : 0.0;
    animate pill-alpha {
        duration: 280ms;
        easing: ease-out;
    }
    pill-timer := Timer {
        // Runs only while the pill is showing; when triggered, it sets
        // pill-visible = false, which flips `running` to false (stopping
        // the timer). Re-shows restart the 5 s countdown from scratch.
        interval: 5s;
        running: root.pill-visible;
        triggered => {
            root.pill-visible = false;
        }
    }

    // ── Boot splash ───────────────────────────────────────────────────────
    // Rust sets boot-done = true once startup checks finish. The internal
    // boot-overlay-alpha binding reacts to that change, and the animate block
    // smoothly fades the overlay out over 500 ms. (Slint doesn't allow
    // animate on `in` properties, so we drive it through an internal float.)
    in property <bool> boot-done: false;
    property <float> boot-overlay-alpha: root.boot-done ? 0.0 : 1.0;
    animate boot-overlay-alpha {
        duration: 500ms;
        easing: ease-in;
    }

    // ── Status bar (top-center, shown on every view) ──────────────────────
    in property <bool> wifi-connected: false;
    in property <string> wifi-ssid: "";
    // -1 = unknown / no battery (desktop install); 0-100 = real percentage.
    in property <int> battery-percent: -1;
    in property <bool> battery-charging: false;

    in property <bool> spotify-has-more: false;
    in property <bool> spotify-is-loading: true;
    callback toggle-fullscreen();

    in property <string> spotify-user-name: "Bryant";
    in property <[UITrack]> spotify-recent-tracks: [];
    in property <[UITrack]> spotify-user-playlists: [];
    in property <[UITrack]> spotify-top-artists: [];
    in property <[UITrack]> spotify-search-results: [];
    in property <string> spotify-album-title;
    in property <string> spotify-album-artist;
    in property <image> spotify-album-cover;
    in property <[UITrack]> spotify-album-tracks: [];
    in property <bool> spotify-album-is-loading: false;

    // Artist view properties
    in property <string> spotify-artist-name: "";
    in property <image> spotify-artist-photo;
    in property <[UITrack]> spotify-artist-top-tracks: [];
    in property <[UITrack]> spotify-artist-albums: [];
    in property <bool> spotify-artist-is-loading: false;

    // OOBE properties & callbacks
    in property <image> oobe-wifi-qr-code;
    in property <string> oobe-wifi-status: "Initializing...";
    in property <string> oobe-wifi-hotspot-ssid: "R-Audio-Setup";
    in property <string> oobe-wifi-url: "http://10.42.0.1:8888/wifi";
    callback oobe-get-started();
    callback oobe-skip-wifi();

    // Spotify Pairing properties & callbacks
    in property <image> spotify-pairing-qr-code;
    in property <string> spotify-pairing-url: "http://r-audio.local:8888";
    in property <string> spotify-pairing-status: "";
    callback spotify-cancel-pairing();
    callback spotify-regenerate-pairing();

    // Spotify Accounts properties & callbacks
    in property <[UIAccount]> spotify-accounts: [];
    callback spotify-select-account(string);
    callback spotify-logout-account(string);
    callback spotify-add-account();
    callback spotify-switch-account();

    callback search-music(string);
    callback backspace-pressed(string) -> string;
    callback play-track(string);
    callback load-more();
    callback open-album(string);
    callback open-playlist(string, string);
    callback open-artist(string);
    callback open-spotify-provider();
    callback open-album-by-id(string);  // opens an album directly by album ID
    // Settings properties & callbacks
    in property <[UIWifiNetwork]> settings-wifi-networks: [];
    in property <[UIBluetoothDevice]> settings-bluetooth-devices: [];
    in property <bool> settings-wifi-scanning: false;
    in property <bool> settings-bluetooth-scanning: false;
    in property <string> settings-current-device-name: "r-audio";
    in property <string> settings-status-message: "";
    callback settings-scan-wifi();
    callback settings-connect-wifi(string, string);
    callback settings-update-device-name(string);
    callback settings-scan-bluetooth();
    callback settings-connect-bluetooth(string);

    // Player Bar Properties
    in property <bool> player-is-playing: false;
    in property <string> player-track-title: "";
    in property <string> player-track-artist: "";
    in property <image> player-album-cover;
    in property <string> player-current-time-str: "0:00";
    in property <string> player-total-time-str: "0:00";
    in property <float> player-progress-percent: 0.0;
    // in-out so the FocusScope key handler can update it locally when the
    // user presses the Surface Go 2's hardware volume buttons.
    in-out property <float> player-volume: 0.8;
    in property <string> player-track-id: "";
    in property <bool> player-is-liked: false;
    in property <bool> player-is-saved: false;
    in property <[float]> player-spectrum-bands: [];
    in property <image> player-bg-image;

    callback player-toggle-play();
    callback player-next-track();
    callback player-prev-track();
    callback player-seek(float);
    callback player-change-volume(float);
    callback player-add-to-liked-songs(string);
    callback player-remove-from-liked-songs(string);
    callback player-add-to-playlist(string, string);
    callback player-remove-from-playlist(string, string);

    // --- ANIMATED BACKGROUND ---
    // Each orb has two independent angle properties, one for X and one for Y.
    // Each goes exactly 0deg→360deg so sin/cos always return the same value at
    // loop start and end — no visible jump, ever.
    property <angle> ox1: 0deg;
    property <angle> oy1: 0deg;
    property <angle> ox2: 0deg;
    property <angle> oy2: 0deg;
    property <angle> ox3: 0deg;
    property <angle> oy3: 0deg;
    property <angle> ox4: 0deg;
    property <angle> oy4: 0deg;

    animate ox1 {
        duration: 14200ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy1 {
        duration: 21700ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox2 {
        duration: 19100ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy2 {
        duration: 12400ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox3 {
        duration: 10800ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy3 {
        duration: 16300ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox4 {
        duration: 17500ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy4 {
        duration: 23100ms;
        easing: linear;
        iteration-count: -1;
    }

    init => {
        ox1 = 360deg;
        oy1 = 360deg;
        ox2 = 360deg;
        oy2 = 360deg;
        ox3 = 360deg;
        oy3 = 360deg;
        ox4 = 360deg;
        oy4 = 360deg;
    }

    // Background Layer
    Rectangle {
        width: 100%;
        height: 100%;

        // Orb 1 — Rich red, top-left
        Rectangle {
            x: (parent.width * 0.15 + 110px * Math.sin(root.ox1)) - 220px;
            y: (parent.height * 0.18 + 75px * Math.cos(root.oy1)) - 220px;
            width: 440px;
            height: 440px;
            border-radius: 220px;
            background: @radial-gradient(circle, #9b2020bb 0%, #9b202000 100%);
        }

        // Orb 2 — Deep purple, right
        Rectangle {
            x: (parent.width * 0.75 + 130px * Math.cos(root.ox2)) - 200px;
            y: (parent.height * 0.52 + 95px * Math.sin(root.oy2)) - 200px;
            width: 400px;
            height: 400px;
            border-radius: 200px;
            background: @radial-gradient(circle, #6020a0bb 0%, #6020a000 100%);
        }

        // Orb 3 — Magenta, bottom-center
        Rectangle {
            x: (parent.width * 0.45 + 150px * Math.sin(root.ox3)) - 170px;
            y: (parent.height * 0.79 + 55px * Math.cos(root.oy3)) - 170px;
            width: 340px;
            height: 340px;
            border-radius: 170px;
            background: @radial-gradient(circle, #a0106099 0%, #a0106000 100%);
        }

        // Orb 4 — Dark indigo, top-right
        Rectangle {
            x: (parent.width * 0.85 + 70px * Math.cos(root.ox4)) - 140px;
            y: (parent.height * 0.14 + 85px * Math.sin(root.oy4)) - 140px;
            width: 280px;
            height: 280px;
            border-radius: 140px;
            background: @radial-gradient(circle, #20408099 0%, #20408000 100%);
        }

        // Vignette
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #00000050 0%, #00000000 30%, #00000000 70%, #00000050 100%);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        // =========================================================
        // --- OOBE WELCOME ---
        // =========================================================
        if active-view == "oobe-welcome": Rectangle {
            vertical-stretch: 1;
            OobeWelcome {
                width: 100%;
                height: 100%;
                get-started => { root.oobe-get-started(); }
            }
        }

        // --- OOBE WI-FI SETUP ---
        if active-view == "oobe-wifi": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                WifiSetup {
                    qr-code: root.oobe-wifi-qr-code;
                    hotspot-ssid: root.oobe-wifi-hotspot-ssid;
                    setup-url: root.oobe-wifi-url;
                    status-message: root.oobe-wifi-status;
                    skip => { root.oobe-skip-wifi(); }
                }
            }
        }

        // =========================================================
        // --- HOME / LANDING PAGE ---
        // =========================================================
        if active-view == "home": Rectangle {
            width: 100%;
            vertical-stretch: 1;

            // Home content
            VerticalBox {
                width: 100%;
                height: 100%;
                spacing: 0px;
                padding: 0px;

                // Centering spacers
                Rectangle {
                    vertical-stretch: 1;
                }

                // App title
                Text {
                    text: "R·Audio";
                    color: white;
                    font-size: 48px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                // Tagline
                Text {
                    text: "YOUR MUSIC. ONE PLACE.";
                    color: #ffffff55;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                }

                // Spacer
                Rectangle {
                    height: 20px;
                }

                // Thin divider line
                Rectangle {
                    height: 1px;
                    background: #ffffff18;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    height: 16px;
                }

                // Section label
                Text {
                    text: "SELECT A PROVIDER";
                    color: #ffffff40;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 3px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    height: 16px;
                }

                // Provider cards row
                HorizontalLayout {
                    alignment: center;
                    spacing: 28px;

                    ProviderCard {
                        title: "Spotify";
                        has-logo: true;
                        logo-source: @image-url("assets/Spotify.svg");
                        clicked => {
                            root.open-spotify-provider();
                        }
                    }

                    ProviderCard {
                        title: "Tidal";
                        has-logo: true;
                        logo-source: @image-url("assets/Tidal.png");
                        brand-color: #000000;
                        clicked => {
                        }
                    }

                    ProviderCard {
                        title: "Audible";
                        has-logo: true;
                        logo-source: @image-url("assets/Audible.png");
                        brand-color: #F5A623;
                        clicked => {
                        }
                    }
                }

                Rectangle {
                    height: 16px;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 28px;

                    ProviderCard {
                        title: "Local";
                        has-logo: true;
                        logo-source: @image-url("assets/USB.svg");
                        clicked => {
                        }
                    }

                    Rectangle {
                        width: 220px;
                    }

                    Rectangle {
                        width: 220px;
                    }
                }

                Rectangle {
                    height: 16px;
                }

                // Footer hint
                Text {
                    text: "More providers coming soon";
                    color: #ffffff28;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }

            // Gear button — top-right overlay
            Rectangle {
                x: parent.width - 56px;
                y: 16px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: gear-touch.pressed ? #ffffff22 : (gear-touch.has-hover ? #ffffff11 : #00000033);
                border-width: 1px;
                border-color: gear-touch.has-hover ? #ffffff33 : #ffffff11;

                animate background { duration: 150ms; }

                Image {
                    source: @image-url("assets/settings.svg");
                    width: 20px;
                    height: 20px;
                    colorize: #ffffffcc;
                }

                gear-touch := TouchArea {
                    clicked => { root.active-view = "settings"; }
                    mouse-cursor: pointer;
                }
            }
        }

        // --- SETTINGS ---
        if active-view == "settings": Rectangle {
            vertical-stretch: 1;
            clip: true;
            Settings {
                width: 100%;
                height: 100%;
                wifi-networks: root.settings-wifi-networks;
                bluetooth-devices: root.settings-bluetooth-devices;
                wifi-scanning: root.settings-wifi-scanning;
                bluetooth-scanning: root.settings-bluetooth-scanning;
                current-device-name: root.settings-current-device-name;
                status-message: root.settings-status-message;
                go-back => { root.active-view = "home"; }
                scan-wifi => { root.settings-scan-wifi(); }
                connect-wifi(ssid, pwd) => { root.settings-connect-wifi(ssid, pwd); }
                update-device-name(name) => { root.settings-update-device-name(name); }
                scan-bluetooth => { root.settings-scan-bluetooth(); }
                connect-bluetooth(mac) => { root.settings-connect-bluetooth(mac); }
                backspace-pressed(s) => { root.backspace-pressed(s) }
            }
        }

        // --- SPOTIFY DASHBOARD ---
        if active-view == "spotify-dashboard": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 20px;
                padding-right: 20px;
                SpotifyDashboard {
                    vertical-stretch: 1;
                is-loading: root.spotify-is-loading;
                user-name: root.spotify-user-name;
                recent-tracks: root.spotify-recent-tracks;
                user-playlists: root.spotify-user-playlists;
                top-artists: root.spotify-top-artists;
                go-back => {
                    root.active-view = "home"
                }
                open-search => {
                    root.active-view = "spotify-search"
                }
                play-track(id) => {
                    root.play-track(id)
                }
                open-album(id) => {
                    root.open-album(id)
                }
                open-artist(id) => {
                    root.open-artist(id)
                }
                open-playlist(id, snapshot) => {
                    root.open-playlist(id, snapshot)
                }
                switch-account => {
                    root.spotify-switch-account();
                }
                logout => {
                    root.spotify-logout-account(root.spotify-user-name)
                }
                }
            }
        }

        // --- SPOTIFY SEARCH ---
        if active-view == "spotify-search": Rectangle {
            vertical-stretch: 1;
            clip: true;
            SpotifySearch {
                width: 100%;
                height: 100%;
                search-results: root.spotify-search-results;
                has-more: root.spotify-has-more;
                go-back => {
                    root.active-view = "spotify-dashboard"
                }
                search-music(query) => {
                    root.search-music(query)
                }
                play-track(id) => {
                    root.play-track(id)
                }
                load-more => {
                    root.load-more()
                }
                open-artist(id) => {
                    root.open-artist(id)
                }
            }
        }

        // --- SPOTIFY ALBUM VIEW ---
        // Wrapper is a Rectangle (not VerticalLayout) so it deterministically
        // fills its allocated height — otherwise short albums (few tracks)
        // collapse the wrapper to content size and the PlayerBar floats up
        // into the middle of the screen.
        if active-view == "spotify-album": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 20px;
                padding-right: 20px;
                SpotifyAlbum {
                    vertical-stretch: 1;
                    album-title: root.spotify-album-title;
                    album-artist: root.spotify-album-artist;
                    album-cover: root.spotify-album-cover;
                    tracks: root.spotify-album-tracks;
                    is-loading: root.spotify-album-is-loading;
                    go-back => {
                        root.active-view = "spotify-dashboard"
                    }
                    play-track(id) => {
                        root.play-track(id)
                    }
                }
            }
        }

        // --- SPOTIFY ARTIST VIEW ---
        if active-view == "spotify-artist": Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 20px;
                padding-right: 20px;
                SpotifyArtist {
                    vertical-stretch: 1;
                    artist-name: root.spotify-artist-name;
                    artist-photo: root.spotify-artist-photo;
                    top-tracks: root.spotify-artist-top-tracks;
                    albums: root.spotify-artist-albums;
                    is-loading: root.spotify-artist-is-loading;
                    go-back => {
                        root.active-view = "spotify-dashboard"
                    }
                    play-track(id) => {
                        root.play-track(id)
                    }
                    open-artist-album(id) => {
                        root.open-album-by-id(id)
                    }
                }
            }
        }

        // --- SPOTIFY PAIRING SCREEN ---
        if active-view == "spotify-pairing": VerticalLayout {
            vertical-stretch: 1;
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 20px;
            padding-right: 20px;
            alignment: center;
            SpotifyPairing {
                qr-code: root.spotify-pairing-qr-code;
                pairing-url: root.spotify-pairing-url;
                status: root.spotify-pairing-status;
                cancel => {
                    root.spotify-cancel-pairing();
                }
                regenerate => {
                    root.spotify-regenerate-pairing();
                }
            }
        }

        // --- SPOTIFY ACCOUNTS SCREEN ---
        if active-view == "spotify-accounts": VerticalLayout {
            vertical-stretch: 1;
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 20px;
            padding-right: 20px;
            alignment: center;
            SpotifyAccounts {
                accounts: root.spotify-accounts;
                select_account(name) => {
                    root.spotify-select-account(name);
                }
                logout_account(name) => {
                    root.spotify-logout-account(name);
                }
                add_account => {
                    root.spotify-add-account();
                }
                cancel => {
                    root.spotify-cancel-pairing();
                }
            }
        }

        // PlayerBar at the bottom of the VerticalLayout.
        // Hidden on the home/landing page — its provider cards already fill
        // the screen on the Surface Go 2 and the player bar pushes the
        // "R·Audio" title up under the status pill. Playback controls remain
        // one tap away via the Spotify provider card → dashboard.
        if root.player-track-title != "" && root.active-view != "home": PlayerBar {
            is-playing: root.player-is-playing;
            track-title: root.player-track-title;
            track-artist: root.player-track-artist;
            track-id: root.player-track-id;
            playlists: root.spotify-user-playlists;
            album-cover: root.player-album-cover;
            current-time-str: root.player-current-time-str;
            total-time-str: root.player-total-time-str;
            progress-percent: root.player-progress-percent;
            volume: root.player-volume;
            is-liked: root.player-is-liked;
            is-saved: root.player-is-saved;

            toggle-play => {
                root.player-toggle-play()
            }
            next-track => {
                root.player-next-track()
            }
            prev-track => {
                root.player-prev-track()
            }
            seek(val) => {
                root.player-seek(val)
            }
            change-volume(val) => {
                root.player-change-volume(val)
            }
            add-to-liked-songs(tid) => {
                root.player-add-to-liked-songs(tid)
            }
            remove-from-liked-songs(tid) => {
                root.player-remove-from-liked-songs(tid)
            }
            add-to-playlist(tid, pid) => {
                root.player-add-to-playlist(tid, pid)
            }
            remove-from-playlist(tid, pid) => {
                root.player-remove-from-playlist(tid, pid)
            }
            expand => {
                root.player-expanded = true;
            }
        }
    }

    // Full screen player overlay drawer
    if root.player-track-title != "": FullPlayer {
        width: 100%;
        height: 100%;
        x: 0;
        y: root.player-expanded ? 0px : parent.height;

        is-playing: root.player-is-playing;
        track-title: root.player-track-title;
        track-artist: root.player-track-artist;
        track-id: root.player-track-id;
        album-cover: root.player-album-cover;
        current-time-str: root.player-current-time-str;
        total-time-str: root.player-total-time-str;
        progress-percent: root.player-progress-percent;
        volume: root.player-volume;
        is-liked: root.player-is-liked;
        spectrum-bands: root.player-spectrum-bands;
        bg-image: root.player-bg-image;

        toggle-play => {
            root.player-toggle-play()
        }
        next-track => {
            root.player-next-track()
        }
        prev-track => {
            root.player-prev-track()
        }
        seek(val) => {
            root.player-seek(val)
        }
        change-volume(val) => {
            root.player-change-volume(val)
        }
        add-to-liked-songs(tid) => {
            root.player-add-to-liked-songs(tid)
        }
        remove-from-liked-songs(tid) => {
            root.player-remove-from-liked-songs(tid)
        }
        collapse => {
            root.player-expanded = false;
        }

        animate y {
            duration: 350ms;
            easing: ease-out;
        }
    }

    // ── Floating status bar (top-center) ───────────────────────────────────
    // Combined Wi-Fi + battery pill, centered at the top so it doesn't
    // collide with back/search buttons in any view (those sit in corners).
    // Both indicators are bound to properties updated by the Rust pollers.
    // Auto-hides after 5 s via pill-timer; tap or swipe down on the top
    // strip brings it back.
    Rectangle {
        x: (root.width - self.width) / 2;
        y: 6px;
        width: 280px;
        height: 26px;
        border-radius: 13px;
        background: #00000060;
        border-width: 1px;
        border-color: #ffffff20;
        opacity: root.pill-alpha;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;

            // ── Wi-Fi section ─────────────────────────────────────────────
            HorizontalLayout {
                spacing: 6px;
                alignment: center;

                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.wifi-connected ? #00ff66 : #ff5555;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.wifi-connected
                        ? (root.wifi-ssid != "" ? root.wifi-ssid : "Wi-Fi")
                        : "No Wi-Fi";
                    color: root.wifi-connected ? #ffffffdd : #ffccccdd;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Divider
            Rectangle {
                width: 1px;
                height: 14px;
                background: #ffffff20;
                y: (parent.height - self.height) / 2;
            }

            // ── Battery section ───────────────────────────────────────────
            // Hidden when battery-percent == -1 (no battery detected).
            if root.battery-percent >= 0: HorizontalLayout {
                spacing: 6px;
                alignment: center;

                // Battery icon: 24×11 outline + 2px tip on the right, with
                // an inner fill rectangle whose width scales linearly with
                // percentage. Color is green normally, amber under 30%, red
                // under 15% (unless charging — always green then).
                Rectangle {
                    width: 28px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;

                    // Outline shell
                    battery-shell := Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 24px;
                        height: 13px;
                        border-width: 1.2px;
                        border-color: #ffffffaa;
                        border-radius: 3px;
                        background: transparent;

                        // Fill — width binds to percent (clamped 0..100).
                        Rectangle {
                            x: 2px;
                            y: 2px;
                            width: (parent.width - 4px)
                                * max(0, min(100, root.battery-percent)) / 100;
                            height: parent.height - 4px;
                            border-radius: 1.5px;
                            background: root.battery-charging
                                ? #00ff66
                                : (root.battery-percent <= 15
                                    ? #ff5555
                                    : (root.battery-percent <= 30
                                        ? #ffaa55
                                        : #ffffffdd));
                        }

                        // Lightning bolt overlay when charging.
                        // Drawn with a Slint Path (no asset file needed).
                        // Viewbox 24×24; path traced as a stylized bolt.
                        if root.battery-charging: Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 7px;
                            height: 11px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            fill: #000000bb;
                            commands: "M 13 2 L 4 14 L 11 14 L 11 22 L 20 10 L 13 10 Z";
                        }
                    }

                    // Battery tip (small protrusion on the right)
                    Rectangle {
                        x: 24px;
                        y: 4px;
                        width: 3px;
                        height: 5px;
                        background: #ffffffaa;
                        border-radius: 1px;
                    }
                }

                Text {
                    text: "\{root.battery-percent}%";
                    color: root.battery-percent <= 15 && !root.battery-charging
                        ? #ff8888 : #ffffffdd;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            if root.battery-percent < 0: Text {
                text: "AC";
                color: #ffffff88;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    // ── Top-edge reveal zone for the status pill ──────────────────────────
    // Only `enabled` while the pill is hidden, so it doesn't intercept
    // back-button / search-button presses in views during normal use.
    // Either a tap or a small downward drag at the top brings the pill
    // back for another 5 s.
    if !root.pill-visible: TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 28px;
        clicked => {
            root.pill-visible = true;
        }
        moved => {
            if self.pressed && (self.mouse-y - self.pressed-y) > 6px {
                root.pill-visible = true;
            }
        }
    }

    FocusScope {
        enabled: true;
        init => {
            self.focus();
        } // Capture focus on startup
        key-pressed(event) => {
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape && root.player-expanded) {
                root.player-expanded = false;
                return accept;
            }
            // ── Hardware volume buttons ────────────────────────────────────
            // Slint 1.16's Key enum has no entries for volume / media keys,
            // so we can't catch them here. They're handled in Rust via a
            // /dev/input/event* reader spawned at startup
            // (see spawn_volume_key_listener in main.rs), which updates the
            // same player-volume property and invokes player-change-volume.
            return reject;
        }
    }

    // ── Boot splash overlay ───────────────────────────────────────────────
    // Rendered last so it sits above every other layer. The `if` removes it
    // from the render tree once the fade-out animation completes (alpha → 0),
    // so it doesn't capture pointer events after dismissal.
    if root.boot-overlay-alpha > 0: BootSplash {
        width:   100%;
        height:  100%;
        opacity: root.boot-overlay-alpha;
    }
}
