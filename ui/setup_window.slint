import { WifiSetup } from "components/wifi/wifi_setup.slint";

export component SetupWindow inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    min-width: 400px;
    min-height: 300px;

    background: @linear-gradient(180deg, #102a4e 0%, #0a182d 100%);

    in-out property <image> wifi-setup-qr-code;
    in-out property <string> wifi-setup-ssid: "R-Audio-Setup";
    in-out property <string> wifi-setup-password: "";
    in-out property <string> wifi-setup-url: "http://10.42.0.1:8888/wifi";
    in-out property <string> wifi-setup-status: "Waiting for client connection...";
    callback wifi-skip-setup();
    callback toggle-fullscreen();

    // --- ANIMATED BACKGROUND ---
    property <angle> ox1: 0deg;
    property <angle> oy1: 0deg;
    property <angle> ox2: 0deg;
    property <angle> oy2: 0deg;
    property <angle> ox3: 0deg;
    property <angle> oy3: 0deg;
    property <angle> ox4: 0deg;
    property <angle> oy4: 0deg;

    animate ox1 {
        duration: 14200ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy1 {
        duration: 21700ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox2 {
        duration: 19100ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy2 {
        duration: 12400ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox3 {
        duration: 10800ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy3 {
        duration: 16300ms;
        easing: linear;
        iteration-count: -1;
    }
    animate ox4 {
        duration: 17500ms;
        easing: linear;
        iteration-count: -1;
    }
    animate oy4 {
        duration: 23100ms;
        easing: linear;
        iteration-count: -1;
    }

    init => {
        ox1 = 360deg;
        oy1 = 360deg;
        ox2 = 360deg;
        oy2 = 360deg;
        ox3 = 360deg;
        oy3 = 360deg;
        ox4 = 360deg;
        oy4 = 360deg;
    }

    // Background Layer
    Rectangle {
        width: 100%;
        height: 100%;

        // Orb 1 — Soft blue, top-left
        Rectangle {
            x: (parent.width * 0.15 + 110px * Math.sin(root.ox1)) - 220px;
            y: (parent.height * 0.18 + 75px * Math.cos(root.oy1)) - 220px;
            width: 440px;
            height: 440px;
            border-radius: 220px;
            background: @radial-gradient(circle, #205ca0bb 0%, #205ca000 100%);
        }

        // Orb 2 — Cyan, right
        Rectangle {
            x: (parent.width * 0.75 + 130px * Math.cos(root.ox2)) - 200px;
            y: (parent.height * 0.52 + 95px * Math.sin(root.oy2)) - 200px;
            width: 400px;
            height: 400px;
            border-radius: 200px;
            background: @radial-gradient(circle, #20a0a0ab 0%, #20a0a000 100%);
        }

        // Orb 3 — Dark Blue, bottom-center
        Rectangle {
            x: (parent.width * 0.45 + 150px * Math.sin(root.ox3)) - 170px;
            y: (parent.height * 0.79 + 55px * Math.cos(root.oy3)) - 170px;
            width: 340px;
            height: 340px;
            border-radius: 170px;
            background: @radial-gradient(circle, #103ba088 0%, #103ba000 100%);
        }

        // Orb 4 — Deep Indigo, top-right
        Rectangle {
            x: (parent.width * 0.85 + 70px * Math.cos(root.ox4)) - 140px;
            y: (parent.height * 0.14 + 85px * Math.sin(root.oy4)) - 140px;
            width: 280px;
            height: 280px;
            border-radius: 140px;
            background: @radial-gradient(circle, #18286088 0%, #18286000 100%);
        }

        // Vignette
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #00000050 0%, #00000000 30%, #00000000 70%, #00000050 100%);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        WifiSetup {
            qr-code: root.wifi-setup-qr-code;
            hotspot-ssid: root.wifi-setup-ssid;
            hotspot-password: root.wifi-setup-password;
            setup-url: root.wifi-setup-url;
            status-message: root.wifi-setup-status;
            skip => {
                root.wifi-skip-setup();
            }
        }
    }

    FocusScope {
        enabled: true;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.F11) {
                root.toggle-fullscreen();
                return accept;
            }
            return reject;
        }
    }
}
