import { ScrollView, HorizontalBox, VerticalBox, Spinner } from "std-widgets.slint";

export struct UIWifiNetwork {
    ssid: string,
    signal: string,
}

export struct UIBluetoothDevice {
    name: string,
    mac: string,
    connected: bool,
}

export component Settings inherits Rectangle {
    in property <[UIWifiNetwork]> wifi-networks: [];
    in property <[UIBluetoothDevice]> bluetooth-devices: [];
    in property <bool> wifi-scanning: false;
    in property <bool> bluetooth-scanning: false;
    in property <string> current-device-name: "r-audio";
    in property <string> status-message: "";

    // Live contents of /tmp/r-audio.log, populated by the Debug tab on
    // tab-switch + every 2 s while open. Refreshes via refresh-debug-log
    // callback; cleared via clear-debug-log.
    in property <string> debug-log-content: "";

    in-out property <string> selected-ssid: "";

    callback go-back();
    callback scan-wifi();
    callback connect-wifi(string, string);
    // Ask the host (MainWindow) to open the top-level Wi-Fi password dialog.
    callback open-wifi-password(string);
    callback update-device-name(string);
    // Ask the host (MainWindow) to open the top-level device-name dialog.
    callback open-device-name();
    callback scan-bluetooth();
    callback connect-bluetooth(string);
    callback backspace-pressed(string) -> string;

    // Debug tab — Rust reads /tmp/r-audio.log and writes the tail back into
    // debug-log-content. Clear truncates the file.
    callback refresh-debug-log();
    callback clear-debug-log();

    property <string> active-tab: "wifi";

    // Wi-Fi auto-scan: when the Wi-Fi tab opens we kick off a scan immediately
    // and then repeat a couple more times a few seconds apart (like a phone's
    // Wi-Fi screen), since networks trickle in. `wifi-scan-tick` counts how many
    // scans have been started in the current visit; a Timer drives the repeats
    // until WIFI-SCAN-MAX is reached.
    property <int> wifi-scan-tick: 0;
    property <int> wifi-scan-max: 3;
    // True while the auto-scan burst is in progress (drives the spinner so it
    // stays visible across the gaps between individual scans).
    property <bool> wifi-auto-scanning: root.active-tab == "wifi" && root.wifi-scan-tick < root.wifi-scan-max;

    function start-wifi-autoscan() {
        root.wifi-scan-tick = 1;
        root.scan-wifi();
    }

    init => {
        if (root.active-tab == "wifi") {
            root.start-wifi-autoscan();
        }
    }

    // Re-arm the auto-scan burst each time the user switches back to Wi-Fi.
    changed active-tab => {
        if (root.active-tab == "wifi") {
            root.start-wifi-autoscan();
        }
    }

    VerticalBox {
        width: 100%;
        height: 100%;
        spacing: 16px;
        padding: 20px;

        // --- Nav Header ---
        HorizontalLayout {
            alignment: space-between;
            height: 36px;

            HorizontalLayout {
                spacing: 15px;
                alignment: start;

                Rectangle {
                    width: 36px; height: 36px; border-radius: 18px;
                    background: touch-back.pressed ? #ffffff22 : (touch-back.has-hover ? #ffffff11 : transparent);
                    Image {
                        source: @image-url("../assets/BackBtn.svg");
                        width: 18px; height: 18px; colorize: #ffffffcc;
                    }
                    touch-back := TouchArea {
                        // pointer-down so one tap works even with the keyboard up.
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { root.go-back(); }
                        }
                        mouse-cursor: pointer;
                    }
                }

                Text {
                    text: "Settings";
                    color: white;
                    font-size: 24px;
                    vertical-alignment: center;
                    font-weight: 800;
                }
            }

            if root.status-message != "" : Text {
                text: root.status-message;
                color: #1DB954;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // --- Tab Switcher ---
        HorizontalLayout {
            height: 44px;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                background: #00000040;
                border-width: 1px;
                border-color: #ffffff10;

                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;

                    Rectangle {
                        horizontal-stretch: 1; border-radius: 8px;
                        background: root.active-tab == "wifi" ? #ffffff1c : transparent;
                        Text {
                            text: "Wi-Fi";
                            color: root.active-tab == "wifi" ? white : #ffffff80;
                            font-size: 14px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            // Act on pointer-down so a single tap works even while
                            // a text field is focused (the keyboard is up). With
                            // `clicked`, the focus-out triggered by the press
                            // swallows the first tap.
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { root.active-tab = "wifi"; }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: 8px;
                        background: root.active-tab == "device" ? #ffffff1c : transparent;
                        Text {
                            text: "Device Name";
                            color: root.active-tab == "device" ? white : #ffffff80;
                            font-size: 14px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { root.active-tab = "device"; }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: 8px;
                        background: root.active-tab == "bluetooth" ? #ffffff1c : transparent;
                        Text {
                            text: "Bluetooth";
                            color: root.active-tab == "bluetooth" ? white : #ffffff80;
                            font-size: 14px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { root.active-tab = "bluetooth"; }
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1; border-radius: 8px;
                        background: root.active-tab == "debug" ? #ffffff1c : transparent;
                        Text {
                            text: "Debug";
                            color: root.active-tab == "debug" ? white : #ffffff80;
                            font-size: 14px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.active-tab = "debug";
                                    root.refresh-debug-log();
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Content Panel ---
        Rectangle {
            vertical-stretch: 1;
            border-radius: 16px;
            background: #ffffff0a;
            border-width: 1px;
            border-color: #ffffff10;
            clip: true;

            // 1. Wi-Fi Tab
            if root.active-tab == "wifi" : VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Repeatedly re-scan a few times after entering the tab so
                // slowly-appearing networks show up without a manual refresh.
                Timer {
                    interval: 2.5s;
                    running: root.active-tab == "wifi" && root.wifi-scan-tick < root.wifi-scan-max;
                    triggered => {
                        root.wifi-scan-tick += 1;
                        root.scan-wifi();
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Select a Network";
                            color: white; font-size: 16px; font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.wifi-scanning || root.wifi-auto-scanning : Spinner {
                            indeterminate: true;
                            width: 18px;
                            height: 18px;
                        }
                    }

                    Rectangle {
                        width: 70px; height: 24px; border-radius: 12px;
                        background: refresh-touch.has-hover ? #ffffff22 : #ffffff15;
                        Text { text: "Refresh"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        refresh-touch := TouchArea { mouse-cursor: pointer; clicked => { root.scan-wifi(); } }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    min-height: 80px;

                    VerticalLayout {
                        spacing: 6px;
                        for net in root.wifi-networks : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: root.selected-ssid == net.ssid ? #ffffff1c : (touch-net.has-hover ? #ffffff0c : transparent);
                            border-width: 1px;
                            border-color: root.selected-ssid == net.ssid ? #ffffff33 : transparent;

                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                alignment: space-between;
                                Text { text: net.ssid; color: white; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                Text { text: net.signal + "% signal"; color: #ffffff80; font-size: 12px; vertical-alignment: center; }
                            }
                            touch-net := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected-ssid = net.ssid;
                                    // Open the top-level password dialog.
                                    root.open-wifi-password(net.ssid);
                                }
                            }
                        }
                    }
                }
            }

            // 2. Device Name Tab
            if root.active-tab == "device" : VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: center;

                Text {
                    text: "Device Hostname";
                    color: white; font-size: 18px; font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Change this kiosk's name on the network.\nAccessible at http://[name].local";
                    color: #ffffff80; font-size: 13px;
                    horizontal-alignment: center;
                }

                // Tapping the field opens the top-level edit dialog (so its
                // Apply/Cancel buttons act in one tap with the keyboard up).
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 320px; height: 48px; border-radius: 8px;
                        background: dev-tap.has-hover ? #00000060 : #00000040;
                        border-width: 1px; border-color: #ffffff20;

                        Text {
                            x: 16px;
                            text: root.current-device-name != "" ? root.current-device-name : "Enter device hostname";
                            color: root.current-device-name != "" ? white : #ffffff50;
                            font-size: 16px; vertical-alignment: center; height: 100%;
                        }
                        Text {
                            x: parent.width - self.width - 16px;
                            text: "Edit";
                            color: #1DB954; font-size: 13px; font-weight: 700;
                            vertical-alignment: center; height: 100%;
                        }
                        dev-tap := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-device-name(); }
                        }
                    }
                }
            }

            // 3. Bluetooth Tab
            if root.active-tab == "bluetooth" : VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Bluetooth Audio Outputs"; color: white; font-size: 16px; font-weight: 700; }
                    if root.bluetooth-scanning : Text { text: "Scanning…"; color: #1DB954; font-size: 13px; }
                    if !root.bluetooth-scanning : Rectangle {
                        width: 70px; height: 24px; border-radius: 12px; background: #ffffff15;
                        Text { text: "Scan"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.scan-bluetooth(); } }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    min-height: 120px;

                    VerticalLayout {
                        spacing: 6px;

                        for dev in root.bluetooth-devices : Rectangle {
                            height: 50px;
                            border-radius: 8px;
                            background: dev.connected ? #1db95420 : (touch-dev.has-hover ? #ffffff0c : transparent);
                            border-width: 1px;
                            border-color: dev.connected ? #1DB95440 : transparent;

                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    Text { text: dev.name; color: white; font-size: 14px; font-weight: 600; }
                                    Text { text: dev.mac; color: #ffffff60; font-size: 11px; }
                                }

                                Rectangle {
                                    width: 90px; height: 26px; border-radius: 13px;
                                    background: dev.connected ? #e63946 : #ffffff15;
                                    y: 12px;
                                    Text {
                                        text: dev.connected ? "Disconnect" : "Connect";
                                        color: white; font-size: 11px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            touch-dev := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.connect-bluetooth(dev.mac); }
                            }
                        }

                        if root.bluetooth-devices.length == 0 && !root.bluetooth-scanning : VerticalLayout {
                            padding-top: 30px;
                            Text {
                                text: "No devices found. Click Scan to search.";
                                color: #ffffff60; font-size: 13px; horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // 4. Debug Tab — on-screen viewer for /tmp/r-audio.log so we
            // can diagnose kiosk issues without a keyboard or SSH.
            if root.active-tab == "debug" : VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "R-Audio Log (/tmp/r-audio.log)";
                           color: white; font-size: 16px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 80px; height: 28px; border-radius: 14px; background: #1db95433;
                            border-width: 1px; border-color: #1DB954;
                            Text { text: "Refresh"; color: white; font-size: 11px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.refresh-debug-log(); } }
                        }
                        Rectangle {
                            width: 70px; height: 28px; border-radius: 14px; background: #e6394633;
                            border-width: 1px; border-color: #e63946;
                            Text { text: "Clear"; color: white; font-size: 11px; font-weight: 700;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.clear-debug-log(); } }
                        }
                    }
                }

                // Scrollable monospace text dump. Flickable + viewport-height
                // matches the dashboard/album pattern (ScrollView in std-
                // widgets misbehaves inside vertical-stretch contexts).
                Flickable {
                    vertical-stretch: 1;
                    min-height: 0px;
                    viewport-height: log-text.preferred-height + 16px;
                    viewport-width: self.width;

                    log-text := Text {
                        x: 8px; y: 8px;
                        width: parent.width - 16px;
                        text: root.debug-log-content == ""
                              ? "(no log content yet — interact with the app to populate it, then tap Refresh)"
                              : root.debug-log-content;
                        color: #cccccc;
                        font-size: 10px;
                        font-family: "monospace";
                        wrap: word-wrap;
                    }
                }

                // Auto-refresh every 2 s while the Debug tab is showing.
                // Stops the moment you switch away (running: == "debug").
                Timer {
                    interval: 2s;
                    running: root.active-tab == "debug";
                    triggered => { root.refresh-debug-log(); }
                }
            }
        }
    }

}
