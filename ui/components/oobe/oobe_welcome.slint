export component OobeWelcome {
    callback get-started();

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;

        Rectangle { vertical-stretch: 1; }

        VerticalLayout {
            alignment: center;
            spacing: 14px;

            Text {
                text: "R·Audio";
                color: white;
                font-size: 64px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: "YOUR MUSIC. ONE PLACE.";
                color: #ffffff55;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 4px;
                horizontal-alignment: center;
            }
        }

        Rectangle { height: 40px; }

        Text {
            text: "Let's get you connected. This will only take a minute.";
            color: #ffffffaa;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Rectangle { height: 52px; }

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 220px;
                height: 52px;
                border-radius: 26px;
                background: btn.pressed ? #17a34a : (btn.has-hover ? #22c55e : #1DB954);
                animate background { duration: 150ms; }

                Text {
                    text: "Get Started";
                    color: white;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                btn := TouchArea {
                    clicked => { root.get-started(); }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
