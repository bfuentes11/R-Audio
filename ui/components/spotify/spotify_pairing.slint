export component SpotifyPairing {
    in property <image> qr-code;
    in property <string> pairing-url;
    in property <string> status: "";
    callback cancel();
    callback regenerate();

    // Centered glassmorphic card container
    Rectangle {
        width: 680px;
        height: 380px;
        background: #ffffff0b;
        border-width: 1px;
        border-color: #ffffff15;
        border-radius: 20px;
        clip: true;

        // Subtle gradient overlay for extra premium look
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(135deg, #ffffff06 0%, #ffffff00 100%);
            border-radius: 20px;
        }

        HorizontalLayout {
            padding: 30px;
            spacing: 30px;
            alignment: space-between;

            // Left Side: Text and Instructions
            VerticalLayout {
                width: 320px;
                spacing: 0px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 8px;

                    // Spotify Green Branding Badge
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: #1DB954;
                            y: 3px;
                        }
                        Text {
                            text: "SPOTIFY SETUP";
                            color: #1DB954;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 2px;
                        }
                    }

                    // Main Title
                    Text {
                        text: "Pair Your Account";
                        color: white;
                        font-size: 28px;
                        font-weight: 800;
                    }

                    // Subtitle
                    Text {
                        text: "Link your Spotify Premium account to access playlists, search, and autoplay recommendations.";
                        color: #ffffffaa;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }

                // Interactive Instructions Checklist
                VerticalLayout {
                    spacing: 12px;

                    // Step 1
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #ffffff12;
                            Text {
                                text: "1";
                                color: white;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Scan the QR code with your phone";
                            color: #ffffffdd;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    // Step 2
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #ffffff12;
                            Text {
                                text: "2";
                                color: white;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Authorize R-Audio on your browser";
                            color: #ffffffdd;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    // Step 3
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #1db95420;
                            border-width: 1px;
                            border-color: #1DB95460;
                            Text {
                                text: "3";
                                color: #1DB954;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "Wait! This screen will auto-refresh";
                            color: #1DB954;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                // Status text (shown when there's something to say —
                // "waiting", "connection lost", "PKCE error", etc.).
                if root.status != "": Text {
                    text: root.status;
                    color: #ffaa88;
                    font-size: 11px;
                    font-weight: 500;
                    wrap: word-wrap;
                }

                // Action buttons: "Get New QR" (regenerates session) +
                // "Cancel Setup" (back out of pairing).
                HorizontalLayout {
                    spacing: 8px;

                    // Get New QR — regenerates session_id, busts stale PKCE.
                    TouchArea {
                        clicked => { root.regenerate(); }

                        Rectangle {
                            height: 38px;
                            background: #1DB95418;
                            border-width: 1px;
                            border-color: #1DB95470;
                            border-radius: 10px;

                            Text {
                                text: "Get New QR";
                                color: #1DB954;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Cancel — exits the pairing flow entirely.
                    TouchArea {
                        clicked => { root.cancel(); }

                        Rectangle {
                            height: 38px;
                            background: #ffffff0a;
                            border-width: 1px;
                            border-color: #ffffff18;
                            border-radius: 10px;

                            Text {
                                text: "Cancel Setup";
                                color: #ffffff88;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Right Side: QR Code Container
            VerticalLayout {
                alignment: center;

                // QR Code Container with sleek glow border
                Rectangle {
                    width: 200px;
                    height: 200px;
                    background: #00000030;
                    border-width: 2px;
                    border-color: #ffffff15;
                    border-radius: 16px;

                    // Display QR Image
                    Image {
                        source: root.qr-code;
                        width: 180px;
                        height: 180px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Sleek Loader Spinner if QR is not loaded yet
                    if root.qr-code.width == 0: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Generating QR...";
                            color: #ffffff44;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
