import { ScrollView, HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

export struct UITrack {
    title: string,
    artist: string,
    id: string,
    artist-id: string,
    duration: string,
    album-art: image,
}

export component SpotifySearch inherits Rectangle {
    in property <[UITrack]> search-results: [];
    in property <bool> has-more: false;
    in-out property <string> search-query: "";
    // Height of the virtual keyboard overlay so the results Flickable can
    // shrink its visible area to stay above the keyboard.
    in property <length> keyboard-height: 0px;

    callback search-music(string);
    callback go-back();
    callback play-track(string);
    callback load-more();
    callback open-artist(string);

    // Focusing this (zero-size) scope blurs the search field, clearing
    // TextInputInterface.text-input-focused and dismissing the keyboard.
    dismiss := FocusScope {}

    VerticalBox {
        width: 100%;
        height: 100%;
        spacing: 20px;
        padding-top: 12px;
        // Slide content up when the virtual keyboard is visible so nothing
        // is hidden behind the 320 px overlay. Animated to track the keyboard.
        padding-bottom: root.keyboard-height + 12px;
        padding-left: 20px;
        padding-right: 20px;
        animate padding-bottom { duration: 300ms; easing: ease-out; }

        // --- Nav Bar ---
        HorizontalBox {
            alignment: start;
            padding: 0;
            padding-bottom: 5px;

            Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: touch-back.pressed ? #ffffff22 : (touch-back.has-hover ? #ffffff11 : transparent);
                Image {
                    source: @image-url("../../assets/BackBtn.svg");
                    width: 18px; height: 18px; colorize: #ffffffcc;
                }
                touch-back := TouchArea {
                    // pointer-down so a single tap works while the keyboard is up.
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { root.go-back(); }
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle { width: 15px; }

            Text {
                text: "Search";
                color: white;
                font-size: 24px;
                vertical-alignment: center;
                font-weight: 800;
            }
        }

        // --- Search Bar ---
        HorizontalLayout {
            spacing: 15px;
            height: 48px;

            search_input := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "What do you want to listen to?";
                font-size: 16px;
                text <=> root.search-query;
                accepted => {
                    dismiss.focus();
                    root.search-music(root.search-query);
                }
            }
        }

        Rectangle { height: 10px; }

        // --- Results List ---
        // Flickable + viewport-height (matches dashboard pattern).
        // ScrollView wouldn't drag-scroll on touch in this context.
        Flickable {
            vertical-stretch: 1;
            min-height: 0px;
            viewport-height: search-results-list.preferred-height;
            viewport-width: self.width;
            search-results-list := VerticalLayout {
                spacing: 0px;
                for track[index] in root.search-results : Rectangle {
                    height: 68px;

                    Rectangle {
                        height: 60px;
                        background: touch.pressed ? #ffffff22 : (touch.has-hover ? #ffffff11 : transparent);
                        border-radius: 8px;
                        y: 4px;

                        HorizontalLayout {
                            padding-left: 15px; padding-right: 15px; alignment: space-between;

                            HorizontalLayout {
                                spacing: 15px; alignment: start;

                                VerticalLayout {
                                    alignment: center; width: 36px;
                                    if !touch.has-hover : Text { text: "\{index + 1}"; color: #b3b3b3; font-size: 16px; horizontal-alignment: right; }
                                    if  touch.has-hover : Image { source: @image-url("../../assets/PlayBtn.svg"); width: 16px; height: 16px; colorize: white; }
                                }

                                Rectangle {
                                    width: 44px; height: 44px; border-radius: 4px; clip: true; background: #282828;
                                    Image { width: 100%; height: 100%; source: track.album-art; image-fit: cover; }
                                }

                                VerticalLayout {
                                    alignment: center; spacing: 4px;
                                    Text { text: track.title;  color: touch.has-hover ? #1DB954 : white; font-weight: 600; font-size: 15px; overflow: elide; }
                                    Rectangle {
                                        height: artist-text.preferred-height;
                                        horizontal-stretch: 1;
                                        artist-text := Text {
                                            x: 0;
                                            text: track.artist;
                                            color: track.artist-id != "" && artist-touch.has-hover ? white : #b3b3b3;
                                            font-size: 13px;
                                            overflow: elide;
                                            width: 100%;
                                        }
                                        artist-touch := TouchArea {
                                            width: artist-text.preferred-width;
                                            height: parent.height;
                                            x: 0;
                                            enabled: track.artist-id != "";
                                            mouse-cursor: track.artist-id != "" ? pointer : default;
                                            clicked => { root.open-artist(track.artist-id); }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text { text: track.duration; color: #b3b3b3; font-size: 13px; }
                            }
                        }

                        touch := TouchArea {
                            clicked => { root.play-track(track.id); }
                            mouse-cursor: pointer;
                        }
                    }
                }

                if root.has-more : HorizontalLayout {
                    alignment: center; padding-top: 20px; padding-bottom: 20px;
                    Rectangle {
                        width: 140px; height: 36px; border-radius: 18px;
                        background: touch-more.pressed ? #ffffff22 : (touch-more.has-hover ? #ffffff1a : transparent);
                        border-width: 1px; border-color: touch-more.has-hover ? #ffffff66 : #ffffff33;

                        Text { text: "LOAD MORE"; color: white; font-size: 12px; font-weight: 700; letter-spacing: 2px; horizontal-alignment: center; vertical-alignment: center; }
                        touch-more := TouchArea {
                            clicked => { root.load-more(); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }

}