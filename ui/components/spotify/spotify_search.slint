import { ScrollView, HorizontalBox, VerticalBox, LineEdit } from "std-widgets.slint";

export struct UITrack {
    title: string,
    artist: string,
    id: string,
    artist-id: string,
    duration: string,
    album-art: image,
}

export component SpotifySearch inherits Rectangle {
    in property <[UITrack]> search-results: [];
    in property <bool> has-more: false;
    in-out property <string> search-query: "";

    callback search-music(string);
    callback go-back();
    callback play-track(string);
    callback load-more();
    callback open-artist(string);

    // Show/hide the system on-screen keyboard (onboard). Forwarded to
    // MainWindow → Rust → org.onboard.Onboard.Keyboard.Show/Hide via D-Bus.
    callback request-keyboard(bool);

    private property <length> text-input-margin: 1rem;

    VerticalBox {
        width: 100%;
        height: 100%;
        spacing: 20px;
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 20px;
        padding-right: 20px;

        // --- Nav Bar ---
        HorizontalBox {
            alignment: start;
            padding: 0;
            padding-bottom: 5px;

            Rectangle {
                width: 36px; height: 36px; border-radius: 18px;
                background: touch-back.pressed ? #ffffff22 : (touch-back.has-hover ? #ffffff11 : transparent);
                Image {
                    source: @image-url("../../assets/BackBtn.svg");
                    width: 18px; height: 18px; colorize: #ffffffcc;
                }
                touch-back := TouchArea {
                    clicked => {
                        root.request-keyboard(false);
                        root.go-back();
                    }
                    mouse-cursor: pointer;
                }
            }

            Rectangle { width: 15px; }

            Text {
                text: "Search";
                color: white;
                font-size: 24px;
                vertical-alignment: center;
                font-weight: 800;
            }
        }

        // --- Custom Glass Search Bar ---
        HorizontalLayout {
            spacing: 15px;
            height: 48px;

            Rectangle {
                horizontal-stretch: 1;
                border-radius: 24px;
                background: #ffffff1a;
                border-width: 1px;
                border-color: search_input.has-focus ? #1DB954 : #ffffff33;
                clip: true;

                // Tap zone below the visuals: declared FIRST in source so it
                // renders BELOW Text + TextInput. Direct taps on the
                // TextInput still go to it (TextInput captures mouse events
                // and is rendered on top); taps on the placeholder-text
                // region fall through to this TouchArea, which focuses
                // search_input and explicitly requests onboard — mirroring
                // the settings TextInputs' belt-and-suspenders pattern.
                TouchArea {
                    clicked => {
                        search_input.focus();
                        root.request-keyboard(true);
                    }
                }

                if root.search-query == "" : Text {
                    x: 20px; text: "What do you want to listen to?";
                    color: #ffffff66; font-size: 16px;
                    vertical-alignment: center; height: parent.height; font-weight: 600;
                }

                search_input := TextInput {
                    x: 20px;
                    width: max(parent.width - 40px, self.preferred-width);
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: 16px;
                    color: white;
                    single-line: true;
                    text <=> root.search-query;
                    accepted => {
                        root.request-keyboard(false);
                        root.search-music(root.search-query);
                    }
                    // Drive onboard show/hide off native focus changes.
                    changed has-focus => {
                        root.request-keyboard(self.has-focus);
                    }
                    cursor-position-changed(cursorPos) => {
                        // Handle text scrolling so cursor stays visible
                        if cursorPos.x + self.x < root.text-input-margin {
                            self.x = - cursorPos.x + root.text-input-margin;
                        } else if cursorPos.x + self.x > parent.width - root.text-input-margin - self.text-cursor-width {
                            self.x = parent.width - cursorPos.x - root.text-input-margin - self.text-cursor-width;
                        }
                    }
                }
            }
        }

        Rectangle { height: 10px; }

        // --- Results List ---
        // Flickable + viewport-height (matches dashboard pattern).
        // ScrollView wouldn't drag-scroll on touch in this context.
        Flickable {
            vertical-stretch: 1;
            min-height: 0px;
            viewport-height: search-results-list.preferred-height;
            viewport-width: self.width;
            search-results-list := VerticalLayout {
                spacing: 0px;
                for track[index] in root.search-results : Rectangle {
                    height: 68px;

                    Rectangle {
                        height: 60px;
                        background: touch.pressed ? #ffffff22 : (touch.has-hover ? #ffffff11 : transparent);
                        border-radius: 8px;
                        y: 4px;

                        HorizontalLayout {
                            padding-left: 15px; padding-right: 15px; alignment: space-between;

                            HorizontalLayout {
                                spacing: 15px; alignment: start;

                                VerticalLayout {
                                    alignment: center; width: 36px;
                                    if !touch.has-hover : Text { text: "\{index + 1}"; color: #b3b3b3; font-size: 16px; horizontal-alignment: right; }
                                    if  touch.has-hover : Image { source: @image-url("../../assets/PlayBtn.svg"); width: 16px; height: 16px; colorize: white; }
                                }

                                Rectangle {
                                    width: 44px; height: 44px; border-radius: 4px; clip: true; background: #282828;
                                    Image { width: 100%; height: 100%; source: track.album-art; image-fit: cover; }
                                }

                                VerticalLayout {
                                    alignment: center; spacing: 4px;
                                    Text { text: track.title;  color: touch.has-hover ? #1DB954 : white; font-weight: 600; font-size: 15px; overflow: elide; }
                                    Rectangle {
                                        height: artist-text.preferred-height;
                                        horizontal-stretch: 1;
                                        artist-text := Text {
                                            x: 0;
                                            text: track.artist;
                                            color: track.artist-id != "" && artist-touch.has-hover ? white : #b3b3b3;
                                            font-size: 13px;
                                            overflow: elide;
                                            width: 100%;
                                        }
                                        artist-touch := TouchArea {
                                            width: artist-text.preferred-width;
                                            height: parent.height;
                                            x: 0;
                                            enabled: track.artist-id != "";
                                            mouse-cursor: track.artist-id != "" ? pointer : default;
                                            clicked => {
                                                root.request-keyboard(false);
                                                root.open-artist(track.artist-id);
                                            }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Text { text: track.duration; color: #b3b3b3; font-size: 13px; }
                            }
                        }

                        touch := TouchArea {
                            clicked => {
                                root.request-keyboard(false);
                                root.play-track(track.id);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }

                if root.has-more : HorizontalLayout {
                    alignment: center; padding-top: 20px; padding-bottom: 20px;
                    Rectangle {
                        width: 140px; height: 36px; border-radius: 18px;
                        background: touch-more.pressed ? #ffffff22 : (touch-more.has-hover ? #ffffff1a : transparent);
                        border-width: 1px; border-color: touch-more.has-hover ? #ffffff66 : #ffffff33;

                        Text { text: "LOAD MORE"; color: white; font-size: 12px; font-weight: 700; letter-spacing: 2px; horizontal-alignment: center; vertical-alignment: center; }
                        touch-more := TouchArea { clicked => { root.load-more() } mouse-cursor: pointer; }
                    }
                }
            }
        }
    }

    // (Sliding VirtualKeyboard removed — onboard now handles all on-screen
    // typing; it pops up via D-Bus when search_input.has-focus changes.)
}