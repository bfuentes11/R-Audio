export component ProviderCard inherits Rectangle {
    in property <string> title;
    
    in property <color> brand-color;
    in property <image> logo-source;
    in property <bool> has-logo: false; 
    
    callback clicked;

    // Much wider layout (previously 170x210)
    width: 220px;
    height: 180px;
    border-radius: 24px;
    
    // Translucent glass effect so your custom red/purple gradient shines through
    background: touch.pressed ? #00000066 : (touch.has-hover ? #ffffff1a : #00000033);
    border-width: 1px;
    border-color: touch.has-hover ? #ffffff33 : #ffffff11;

    drop-shadow-color: #00000066;
    drop-shadow-blur: touch.has-hover ? 16px : 8px;
    drop-shadow-offset-y: touch.has-hover ? 8px : 4px;

    animate background { duration: 200ms; easing: ease-in-out; }
    animate border-color { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 200ms; easing: ease-in-out; }
    animate drop-shadow-offset-y { duration: 200ms; easing: ease-in-out; }

    VerticalLayout {
        padding: 20px;
        alignment: center;
        spacing: 20px;

        HorizontalLayout {
            alignment: center;

            if has-logo : Image {
                source: root.logo-source;
                width: 76px;
                height: 76px;
                image-fit: contain; 
            }

            if !has-logo : Rectangle {
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: root.brand-color;
                
                drop-shadow-color: #00000040;
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 4px;
            }
        }

        Text {
            text: root.title;
            color: white;
            font-size: 20px; // Bumped up slightly to fit the wider card
            font-weight: 700;
            letter-spacing: 0.5px;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked() }
        mouse-cursor: pointer;
    }
}