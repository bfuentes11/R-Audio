// Custom text display component that shows a visible cursor at cursor-pos
export component CursorTextDisplay inherits Rectangle {
    in property <string> before-cursor: "";
    in property <string> after-cursor: "";
    in property <length> font-size: 16px;
    in property <color> text-color: white;
    in property <color> cursor-color: #1DB954;

    property <float> cursor-opacity: 1.0;

    // Blink animation
    animate cursor-opacity {
        duration: 1000ms;
    }

    width: 100%;
    height: 100%;

    changed cursor-opacity => {
        if (root.cursor-opacity < 0.5) {
            root.cursor-opacity = 0.0;
        } else if (root.cursor-opacity < 1.0) {
            root.cursor-opacity = 1.0;
        }
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: start;

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                // Before cursor text
                Text {
                    text: root.before-cursor;
                    color: root.text-color;
                    font-size: root.font-size;
                    font-weight: 600;
                    overflow: clip;
                }

                // Visible cursor line (blinking)
                Rectangle {
                    width: 2px;
                    height: root.font-size + 4px;
                    background: root.cursor-color;
                    opacity: root.cursor-opacity;
                }

                // After cursor text
                Text {
                    text: root.after-cursor;
                    color: root.text-color;
                    font-size: root.font-size;
                    font-weight: 600;
                    overflow: clip;
                }
            }
        }
    }
}
