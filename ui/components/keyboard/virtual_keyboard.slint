// Adapted from the official Slint virtual_keyboard example
// (examples/virtual_keyboard, MIT © SixtyFPS GmbH). Restyled to R-Audio's dark
// theme and rendered with text glyphs instead of icon images so it carries no
// external asset dependency.
//
// Keys are injected into whichever Slint TextInput currently has focus, via
// WindowEvent::KeyPressed / KeyReleased dispatched on the Rust side
// (VirtualKeyboardHandler.key-pressed → ui.window().dispatch_event in
// src/main.rs). That means the native cursor, text selection, `accepted`
// (Enter), Backspace and arrow keys all behave exactly as if a real keyboard
// were attached — no per-field text wiring needed.

component VirtualKeyboardButton inherits Rectangle {
    in property <string> key;
    // Function/modifier keys (esc, tab, shift, ⌫, ⏎, ?123, ▾, arrows) get a
    // flatter, dimmer fill so the letter/number keys stand out as the primary
    // targets.
    in property <bool> accent;
    // Highlighted "on" state — used for the shift key while shift is active.
    in property <bool> active;
    callback key-pressed(/* key */ string);

    min-width: 40px;
    min-height: 52px;
    horizontal-stretch: 0;
    border-radius: 8px;

    // Subtle raised keycap: a gentle top-to-bottom gradient reads as a physical
    // key. Letter/number keys sit a shade lighter than the recessed function
    // keys. Pressed = flat + darker (pushed in); the active shift uses the brand
    // green as the single accent.
    background: root.active
        ? @linear-gradient(180deg, #1ED760 0%, #1DB954 100%)
        : i-touch.pressed
            ? #1b1d26
            : root.accent
                ? @linear-gradient(180deg, #262833 0%, #20222c 100%)
                : @linear-gradient(180deg, #353845 0%, #2c2f3a 100%);
    border-width: 1px;
    border-color: root.active ? #25e065 : #00000055;

    // Faint raised shadow.
    drop-shadow-color: #00000066;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;

    animate background, border-color { duration: 90ms; easing: ease-out; }

    // Hairline top highlight for the keycap "bevel".
    Rectangle {
        y: 1px;
        width: parent.width - 2px;
        height: parent.height / 2;
        border-radius: parent.border-radius - 1px;
        background: i-touch.pressed ? transparent : #ffffff0a;
    }

    i-label := Text {
        text: root.key;
        color: root.active
            ? #06140c
            : (root.accent ? #aab0c0 : #f3f4f7);
        font-size: 18px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    i-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.key-pressed(root.key);
            }
        }
    }
}

export struct KeyModel {
    key: string,
    shift-key: string,
}

export global VirtualKeyboardHandler {
    in property <[[[KeyModel]]]> default-key-sets: [
       [
            [
                { key: "q", shift-key: "Q" },
                { key: "w", shift-key: "W" },
                { key: "e", shift-key: "E" },
                { key: "r", shift-key: "R" },
                { key: "t", shift-key: "T" },
                { key: "y", shift-key: "Y" },
                { key: "u", shift-key: "U" },
                { key: "i", shift-key: "I" },
                { key: "o", shift-key: "O" },
                { key: "p", shift-key: "P" }
            ],
            [
                { key: "a", shift-key: "A" },
                { key: "s", shift-key: "S" },
                { key: "d", shift-key: "D" },
                { key: "f", shift-key: "F" },
                { key: "g", shift-key: "G" },
                { key: "h", shift-key: "H" },
                { key: "j", shift-key: "J" },
                { key: "k", shift-key: "K" },
                { key: "l", shift-key: "L" }
            ],
            [
                { key: "z", shift-key: "Z" },
                { key: "x", shift-key: "X" },
                { key: "c", shift-key: "C" },
                { key: "v", shift-key: "V" },
                { key: "b", shift-key: "B" },
                { key: "n", shift-key: "N" },
                { key: "m", shift-key: "M" },
                { key: ",", shift-key: ";" },
                { key: ".", shift-key: ":" },
                { key: "-", shift-key: "_" }
            ],
       ],
       [
            [
                { key: "1", shift-key: "[" },
                { key: "2", shift-key: "]" },
                { key: "3", shift-key: "{" },
                { key: "4", shift-key: "}" },
                { key: "5", shift-key: "#" },
                { key: "6", shift-key: "%" },
                { key: "7", shift-key: "^" },
                { key: "8", shift-key: "*" },
                { key: "9", shift-key: "+" },
                { key: "0", shift-key: "=" }
            ],
            [
                { key: "-", shift-key: "_" },
                { key: "/", shift-key: "\\" },
                { key: ":", shift-key: "|" },
                { key: ";", shift-key: "~" },
                { key: "(", shift-key: "<" },
                { key: ")", shift-key: ">" },
                { key: "$", shift-key: "&" },
                { key: "@", shift-key: "`" },
                { key: "\"", shift-key: "'" },
                { key: "*", shift-key: "%" }
            ],
            [
                { key: ".", shift-key: "." },
                { key: ",", shift-key: "," },
                { key: "?", shift-key: "?" },
                { key: "!", shift-key: "!" },
                { key: "'", shift-key: "'" },
                { key: "_", shift-key: "_" },
                { key: "=", shift-key: "=" },
                { key: "+", shift-key: "+" }
            ],
       ]
    ];

    out property <int> current-key-set;
    out property <[[KeyModel]]> keys: default-key-sets[self.current-key-set];
    in-out property <bool> open;

    callback key_pressed(/* key */ string);

    public function switch-keyboard() {
        if (self.current-key-set < self.default-key-sets.length - 1) {
            self.current-key-set += 1;
        } else {
            self.current-key-set -= 1;
        }
        self.current-key-set = min(self.default-key-sets.length - 1, max(0, self.current-key-set));
    }
}

export component VirtualKeyboard inherits Rectangle {
    private property <bool> shift;

    callback close();

    // Restrained dark panel — a deep, near-flat gradient with a crisp rounded
    // top and a single hairline divider. Reads like a system keyboard tray.
    background: @linear-gradient(180deg, #1a1c26 0%, #141520 100%);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    drop-shadow-color: #000000aa;
    drop-shadow-blur: 36px;
    drop-shadow-offset-y: -8px;

    // Catch-all: absorb taps that land in the gaps between keys (and anywhere on
    // the keyboard background) so they don't fall through to whatever is behind
    // the keyboard — e.g. the search-results list or the Wi-Fi network list —
    // which would otherwise trigger those elements and yank focus off the field
    // we're typing into. (This is the pattern from the Slint example.)
    TouchArea {}

    // Hairline top divider for a clean tray edge.
    Rectangle {
        y: 0;
        height: 1px;
        width: parent.width;
        background: #ffffff14;
    }

    VerticalLayout {
        padding: 14px;
        padding-top: 16px;
        spacing: 8px;
        alignment: center;

        for row[index] in VirtualKeyboardHandler.keys : HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // shift (left)
            if (index == 2) : VirtualKeyboardButton {
                key: "⇧";
                accent: true;
                active: root.shift;
                key-pressed => { root.shift = !root.shift; }
            }

            for km in row : VirtualKeyboardButton {
                key: root.shift ? km.shift-key : km.key;
                key-pressed(key) => {
                    VirtualKeyboardHandler.key-pressed(key);
                    root.shift = false;
                }
            }

            if (index == 0) : VirtualKeyboardButton {
                key: "⌫";
                accent: true;
                key-pressed => { VirtualKeyboardHandler.key-pressed(Key.Backspace); }
            }
            if (index == 1) : VirtualKeyboardButton {
                key: "⏎";
                accent: true;
                key-pressed => { VirtualKeyboardHandler.key-pressed(Key.Return); }
            }
            // shift (right)
            if (index == 2) : VirtualKeyboardButton {
                key: "⇧";
                accent: true;
                active: root.shift;
                key-pressed => { root.shift = !root.shift; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            VirtualKeyboardButton {
                key: "▾";
                accent: true;
                key-pressed => { root.close(); }
            }
            VirtualKeyboardButton {
                key: VirtualKeyboardHandler.current-key-set == 0 ? "?123" : "ABC";
                accent: true;
                key-pressed => {
                    VirtualKeyboardHandler.switch-keyboard();
                    root.shift = false;
                }
            }
            VirtualKeyboardButton {
                horizontal-stretch: 1;
                key: " ";
                key-pressed(key) => {
                    root.shift = false;
                    VirtualKeyboardHandler.key-pressed(key);
                }
            }
            VirtualKeyboardButton {
                key: "←";
                accent: true;
                key-pressed => { VirtualKeyboardHandler.key-pressed(Key.LeftArrow); }
            }
            VirtualKeyboardButton {
                key: "→";
                accent: true;
                key-pressed => { VirtualKeyboardHandler.key-pressed(Key.RightArrow); }
            }
        }
    }
}
