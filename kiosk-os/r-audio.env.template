# ==============================================================================
# R-Audio Kiosk — Runtime Environment Template
# ==============================================================================
# This file is copied to /etc/default/r-audio on the installed kiosk. It contains
# ONLY non-sensitive defaults — actual secrets (RSPOTIFY_CLIENT_SECRET,
# LASTFM_API_KEY, SPOTIFY_APP_SECRET) are injected at ISO build time by
# build-iso.sh's `inject_secret` calls, which read them from env vars sourced
# from GitHub Actions secrets in CI.
#
# To add a new GitHub Actions secret:
#   1. Generate / rotate the secret value at its provider
#   2. GitHub repo → Settings → Secrets and variables → Actions → New secret
#   3. Add a passthrough line in .github/workflows/build-kiosk-iso.yml under
#      the "Build Kiosk ISO" step's env: block
#   4. Add an `inject_secret NAME "${NAME:-}"` line in build-iso.sh
#
# DO NOT add real secret values here.
# ==============================================================================

# ── Public / non-sensitive ────────────────────────────────────────────────────
# Spotify OAuth client ID is public by design (appears in OAuth URLs).
RSPOTIFY_CLIENT_ID=d006d6e7ae7a4acdb78f3f6a37dc6b26
RSPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
DEVICE_NAME=R-Audio

# ── Slint display settings ────────────────────────────────────────────────────
# Force X11 backend (prevents Wayland negotiation delays at startup).
WINIT_UNIX_BACKEND=x11
# Scale factor for the Surface Go 2's 217 PPI 1800x1200 screen.
SLINT_SCALE_FACTOR=2.0
# Force fullscreen (no window decorations, fills screen).
SLINT_FULLSCREEN=1

# ── Injected at build time from GitHub Actions secrets ────────────────────────
# Do NOT uncomment or fill these in here. build-iso.sh appends real values
# from the matching ${{ secrets.* }} workflow env-vars.
#
# SPOTIFY_APP_SECRET=<injected>
# RSPOTIFY_CLIENT_SECRET=<injected>
# LASTFM_API_KEY=<injected>
