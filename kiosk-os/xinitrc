#!/bin/sh
# R-Audio Bare-Metal X11 Startup Script
# Place this at /home/kiosk/.xinitrc on the target system

# Disable screen blanking, screensaver, and DPMS power-saving modes
xset s off
xset s noblank
xset -dpms

# Start a window manager so X11 honors EWMH fullscreen hints from Slint.
# openbox is installed via the bundled .debs during d-i postinstall, so it's
# available from the very first boot — no special first-boot handling needed.
if command -v openbox-session >/dev/null 2>&1; then
    openbox-session &
fi

# Start onboard on-screen keyboard if installed (touch input for kiosk settings).
# --xid mode makes it dockable; we use floating layout with auto-show on text focus.
# Layout 'Phone' is touch-optimized (large keys, full QWERTY + symbols).
if command -v onboard >/dev/null 2>&1; then
    onboard --layout=Phone --theme=Nightshade &
fi

# Execute the R-Audio launcher. 
# Using "exec" makes it replace the shell process, ensuring X11 shuts down if the launcher exits.
exec /usr/local/bin/r-audio-launcher
