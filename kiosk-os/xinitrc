#!/bin/sh
# R-Audio Bare-Metal X11 Startup Script
# Place this at /home/kiosk/.xinitrc on the target system

# Redirect xinitrc's own output to the same log r-audio uses, so messages
# from openbox / matchbox-keyboard / our startup diagnostics show up in the
# on-screen Debug tab. `>` truncates so each session starts with a fresh
# log; the launcher uses `>>` to append.
exec > /tmp/r-audio.log 2>&1

# ──────────────────────────────────────────────────────────────────────────────
# Fix #2 (D-Bus session bus): startx by itself doesn't bring up a session bus,
# which means:
#   • onboard can't register its org.onboard.Onboard service
#   • r-audio's dbus-send calls to Show/Hide the keyboard have nowhere to go
# Re-exec the entire xinitrc body under dbus-run-session the first time
# through. dbus-run-session starts a private session bus, exports
# DBUS_SESSION_BUS_ADDRESS into the environment, runs the rest of the script,
# and cleans the bus up when the script exits.
# ──────────────────────────────────────────────────────────────────────────────
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    exec dbus-run-session -- "$0" "$@"
fi

# Disable screen blanking, screensaver, and DPMS power-saving modes
xset s off
xset s noblank
xset -dpms

# Start a window manager so X11 honors EWMH fullscreen hints from Slint.
# openbox is installed via the bundled .debs during d-i postinstall, so it's
# available from the very first boot — no special first-boot handling needed.
if command -v openbox-session >/dev/null 2>&1; then
    openbox-session &
fi

# ──────────────────────────────────────────────────────────────────────────────
# Matchbox on-screen keyboard.
#
# We use matchbox-keyboard (not onboard): a lightweight C/GTK2 OSK designed
# for touchscreen kiosks. It just works without onboard's heavy Python+a11y
# dep tree (which silently fails to install offline and leaves us with
# "no such file or directory" when D-Bus tries to spawn it).
#
# Show/hide is driven by R-Audio via xdotool windowmap / windowunmap on the
# keyboard's X11 window — no D-Bus, no service activation, no spawn race.
# See ui.on_request_keyboard in src/main.rs for the runtime side.
#
# Startup hide loop: matchbox-keyboard starts visible. We wait for its
# window (xdotool returns non-zero until it exists, so this doubles as the
# "is matchbox up?" probe), then unmap so it stays hidden until a text
# input is focused. wmctrl `add,above` keeps it on the always-on-top
# stacking layer even after R-Audio takes back focus.
# ──────────────────────────────────────────────────────────────────────────────
echo "[xinitrc] matchbox-keyboard path: $(command -v matchbox-keyboard || echo 'NOT FOUND')"
if command -v matchbox-keyboard >/dev/null 2>&1; then
    matchbox-keyboard > /tmp/matchbox-keyboard.log 2>&1 &
    (
        for i in 1 2 3 4 5 6 7 8; do
            sleep 1
            if xdotool search --class matchbox-keyboard --sync windowunmap %@ >/dev/null 2>&1; then
                wmctrl -r "matchbox-keyboard" -b add,above >/dev/null 2>&1
                echo "[xinitrc] matchbox-keyboard ready (attempt $i)"
                break
            fi
        done
    ) &
else
    echo "[xinitrc] matchbox-keyboard binary not found — on-screen keyboard disabled."
fi

# Execute the R-Audio launcher.
# Using "exec" makes it replace the shell process, ensuring X11 shuts down if
# the launcher exits.
exec /usr/local/bin/r-audio-launcher
